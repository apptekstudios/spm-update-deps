{
  "name": "spm-update",
  "version": "2.0.0",
  "description": "Check and update Swift Package Manager dependencies in Package.swift and .xcodeproj files. Agent-friendly.",
  "type": "module",
  "private": true,
  "bin": {
    "spm-update": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/spm-update",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bacons/xcode": "^1.0.0-alpha.27",
    "@clack/prompts": "^1.8.1",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3"
  }
}
